{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**"
    },
    "api/[[...path]].js": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": "/api/uploads/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
