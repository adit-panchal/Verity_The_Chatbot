# ===== SERVER CONFIGURATION =====
PORT=5005
NODE_ENV=development

# ===== DATABASE =====
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/chatbot-db

# ===== AI PROVIDERS (Choose at least one) =====
# Option 1: Google Groq (FREE - Recommended for getting started)
Groq_API_KEY=your_google_Groq_api_key

# Option 2: OpenAI (Paid - ~$0.001 per 1K tokens)
OPENAI_API_KEY=your_openai_api_key

# Option 3: Groq (FREE - Fast open-source models)
GROQ_API_KEY=your_groq_api_key

# ===== WEB SEARCH PROVIDER (Choose one for real-time info) =====
# Option 1: Brave Search (RECOMMENDED - Privacy-focused, faster)
# Get free API key at: https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# Option 2: SerpAPI (Alternative)
# Get free tier at: https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_key

# ===== SECURITY & ENCRYPTION =====
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-very-secret-encryption-key-at-least-32-characters-long

# JWT Secret for token authentication
JWT_SECRET=your-jwt-secret-key-change-in-production

# ===== OPTIONAL: EMAIL NOTIFICATIONS =====
# For data export and account deletion notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ===== OPTIONAL: ANALYTICS =====
# For tracking usage statistics (if implemented)
SENTRY_DSN=your_sentry_dsn_for_error_tracking
ANALYTICS_ENABLED=false

# ===== FEATURE FLAGS =====
ENABLE_WEB_SEARCH=true
ENABLE_ENCRYPTION=true
ENABLE_USER_SETTINGS=true
ENABLE_RATE_LIMITING=false

# ===== CORS CONFIGURATION =====
FRONTEND_URL=http://localhost:5173
