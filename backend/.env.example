# ===== SERVER CONFIGURATION =====
PORT=5005
NODE_ENV=development

# ===== DATABASE: SUPABASE (PostgreSQL) =====
# Get these from your Supabase project settings
# Dashboard: https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# ===== AUTHENTICATION =====
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-change-in-production

# ===== AI PROVIDERS (Choose at least one) =====
# Option 1: Groq (FREE - Recommended for getting started)
GROQ_API_KEY=your_groq_api_key

# Option 2: OpenAI (Paid - ~$0.001 per 1K tokens)
OPENAI_API_KEY=your_openai_api_key

# ===== WEB SEARCH PROVIDER (Choose one for real-time info) =====
# Option 1: Brave Search (RECOMMENDED - Privacy-focused, faster)
# Get free API key at: https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# Option 2: SerpAPI (Alternative)
# Get free tier at: https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_key

# ===== EMAIL NOTIFICATIONS =====
# For OTP, 2FA, and account notifications
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ===== ENCRYPTION =====
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-very-secret-encryption-key-at-least-32-characters-long

# ===== OPTIONAL: ERROR TRACKING =====
# For tracking errors and performance (if implemented)
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# ===== FEATURE FLAGS =====
ENABLE_WEB_SEARCH=true
ENABLE_ENCRYPTION=true
ENABLE_USER_SETTINGS=true
ENABLE_2FA=true
ENABLE_RATE_LIMITING=false

# ===== CORS CONFIGURATION =====
FRONTEND_URL=http://localhost:5175

# ===== VERCEL DEPLOYMENT =====
# Set to 'production' when deploying to Vercel
# NODE_ENV=production
